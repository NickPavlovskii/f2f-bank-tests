{
  "name": "f2f-bank-tests",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:smoke": "playwright test --grep @critical",
    "test:auth": "playwright test --project=logged-out",
    "test:logged-in": "playwright test --project=setup --project=logged-in",
    "test:high": "playwright test --grep \"@critical|@high\""
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.4.0"
  }
}
